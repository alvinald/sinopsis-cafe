// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum status {
  ACTIVE
  INACTIVE
}

// Model Master Role
model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()::text"))
  name        String  @unique // Contoh: "master", "admin", "editor"
  description String?
  isDeleted   Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  @@map("role")
}

// Model Master Permission (Resource & Action)
model Permission {
  id       String           @id @default(dbgenerated("gen_random_uuid()::text"))
  resource String // Contoh: "user", "post", "system"
  action   String // Contoh: "create", "read", "update", "delete"
  roles    RolePermission[]

  @@unique([resource, action])
  @@map("permission")
}

// Model Pivot (Tabel Penghubung Role <-> Permission)
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  status        status    @default(ACTIVE)
  isScheduled   Boolean   @default(false)
  resignedDate  DateTime? @map("resigned_date") @db.Date
  resignReason  String?   @map("resign_reason")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)

  jobTitle   JobTitle? @relation(fields: [jobTitleId], references: [id])
  jobTitleId String?

  role   Role?   @relation(fields: [roleId], references: [id])
  roleId String?

  sessions           Session[]
  accounts           Account[]
  shiftSchedules     ShiftSchedule[]
  createdStockOuts   StockOut[]
  sentStockOuts      StockOut[]      @relation("SentStockOuts")
  receivedStockOuts  StockOut[]      @relation("ReceivedStockOuts")
  cancelledStockOuts StockOut[]      @relation("CancelledStockOuts")
  stockIns           StockIn[]
  cancelledStockIns  StockIn[]       @relation("CancelledStockIns")

  @@unique([email])
  @@map("user")
}

model Session {
  id          String   @id
  expiresAt   DateTime
  token       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ipAddress   String?
  userAgent   String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[] @default([]) // <-- Pastikan baris ini ada

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum LevelJob {
  OWNER
  DIREKTUR
  MANAGER
  HEAD
  STAFF
}

model JobTitle {
  id           String      @id @default(dbgenerated("gen_random_uuid()::text"))
  name         String
  level        LevelJob
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  users User[]

  @@map("job_title")
}

model Department {
  id        String     @id @default(dbgenerated("gen_random_uuid()::text"))
  name      String
  jobTitles JobTitle[]

  @@map("department")
}

model ShiftSchedule {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  userId      String   @map("user_id") // Foreign Key merujuk ke User
  shiftTypeId Int      @map("shift_type_id")
  date        DateTime @db.Date

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftType ShiftType @relation(fields: [shiftTypeId], references: [id])

  @@unique([userId, date])
  @@map("shift_schedules")
}

model ShiftType {
  id        Int             @id @default(autoincrement())
  name      String
  startTime String?         @map("start_time")
  endTime   String?         @map("end_time")
  color     String?
  schedules ShiftSchedule[]

  @@map("shift_types")
}

enum StockOutStatus {
  PENDING // dibuat, barang belum dikirim
  SENT // dikirim (stok belum berubah)
  RECEIVED // diterima (stok berkurang)
  CANCELLED // dibatalkan
}

enum StockInStatus {
  PENDING // dibuat, stok belum berubah
  RECEIVED // diterima, stok bertambah
  CANCELLED // dibatalkan sebelum diterima
}

model Item {
  id     String @id @default(dbgenerated("gen_random_uuid()::text"))
  sku    String @unique
  name   String
  unit   String // pcs, box, kg, dst
  stock  Int    @default(0)
  status status @default(ACTIVE)

  isDeleted Boolean @default(false) @map("is_deleted")

  stockOutItems StockOutItem[]
  stockInItems  StockInItem[]

  @@map("items")
}

model StockOut {
  id         String         @id @default(dbgenerated("gen_random_uuid()::text"))
  number     String         @unique
  status     StockOutStatus @default(PENDING)
  note       String?
  createdAt  DateTime       @default(now()) @map("created_at")
  sentAt     DateTime?      @map("sent_at")
  receivedAt DateTime?      @map("received_at")

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @map("created_by_id")

  // 2. Pengirim (Sent By) - Opsional / Nullable
  sentBy   User?   @relation("SentStockOuts", fields: [sentById], references: [id])
  sentById String? @map("sent_by_id")

  // 3. Penerima (Received By) - Opsional / Nullable
  receivedBy   User?   @relation("ReceivedStockOuts", fields: [receivedById], references: [id])
  receivedById String? @map("received_by_id")

  // 4. Pembatal (Cancelled By) - Opsional / Nullable
  cancelledBy   User?   @relation("CancelledStockOuts", fields: [cancelledById], references: [id])
  cancelledById String? @map("cancelled_by_id")

  items StockOutItem[]

  @@map("stock_outs")
}

model StockOutItem {
  id         String @id @default(dbgenerated("gen_random_uuid()::text"))
  stockOutId String @map("stock_out_id")
  itemId     String @map("item_id")
  qty        Int

  stockOut StockOut @relation(fields: [stockOutId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])

  @@unique([stockOutId, itemId])
  @@map("stock_out_items")
}

model StockIn {
  id         String        @id @default(dbgenerated("gen_random_uuid()::text"))
  number     String        @unique
  status     StockInStatus @default(PENDING)
  note       String?
  receivedAt DateTime?     @map("received_at")

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @map("created_by_id")

  cancelledBy   User?     @relation("CancelledStockIns", fields: [cancelledById], references: [id])
  cancelledById String?   @map("cancelled_by_id")
  cancelledAt   DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items StockInItem[]

  @@map("stock_ins")
}

model StockInItem {
  id        String @id @default(dbgenerated("gen_random_uuid()::text"))
  stockInId String @map("stock_in_id")
  itemId    String @map("item_id")
  qty       Int

  stockIn StockIn @relation(fields: [stockInId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id])

  @@unique([stockInId, itemId])
  @@map("stock_in_items")
}
